# Copy this file to .env and fill in real values. Never commit .env.
# On Railway, add each of these under your service's "Variables" tab instead.

# Port the server listens on. Railway sets this for you automatically.
PORT=3000

# --- WhatsApp Cloud API (from your Meta app: WhatsApp > API Setup) ---
# A password you invent. You type the same value into Meta's webhook settings
# so Meta can prove the webhook URL is yours.
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-string
# App secret (Meta app > App settings > Basic > App secret). Used to check that
# incoming webhooks really came from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Access token used to send messages (temporary token for testing, or a
# permanent System User token for production).
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# The "Phone number ID" shown under WhatsApp > API Setup (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Graph API version used in API calls.
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- Supabase (Project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server-only: never put it in a website or mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Voice notes (optional) ---
# Groq API key (console.groq.com > API Keys) used to turn voice notes into text.
# Leave empty to switch voice notes off; customers are then asked to type.
GROQ_API_KEY=
# Groq speech-to-text model.
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Which product answers messages ---
# "echo" repeats messages back (Phase 0 test). "quote" runs the KahnPrints quote
# and order bot. Leave as echo until the price list is loaded in Supabase.
ACTIVE_PRODUCT=echo

# --- Quote and order bot (only needed when ACTIVE_PRODUCT=quote) ---
# Anthropic API key (console.anthropic.com > API keys). Used to understand customers.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Claude model used to read messages.
ANTHROPIC_MODEL=claude-haiku-5-5
# Business name the bot uses in replies.
QUOTE_BUSINESS_NAME=KahnPrints
# Order numbers look like KP-1001.
QUOTE_ORDER_PREFIX=KP
# WhatsApp number that gets a message for every confirmed order, in international
# format with no + or spaces (e.g. 2348012345678). Leave empty for no alerts.
QUOTE_OWNER_WA_ID=

# --- Construction site progress reporter (optional) ---
# The "Phone number ID" of a second WhatsApp number (e.g. Meta's test number).
# Messages to that number go to the site reporter; the number above keeps
# running ACTIVE_PRODUCT. Leave empty to switch the site reporter off.
# Needs ANTHROPIC_API_KEY (above) to write the daily reports.
SITE_PHONE_NUMBER_ID=
# Hour of the day, Lagos time (0-23), when the daily report goes to site managers.
SITE_REPORT_HOUR=18

# --- Real estate lead qualifier (optional) ---
# The "Phone number ID" of the WhatsApp number property enquiries come in on.
# Messages to that number go to the lead qualifier. Leave empty to switch it off.
# Needs ANTHROPIC_API_KEY (above) to read messages.
LEADS_PHONE_NUMBER_ID=
# Agents who get a WhatsApp alert for every hot lead, in international format,
# separated by commas (e.g. 2348012345678,2348098765432). Required when the
# lead qualifier is on. Agents can also text "leads" to that number.
LEADS_AGENT_WA_IDS=
# The business name the bot uses with enquirers, e.g. "Acme Homes".
LEADS_BUSINESS_NAME=

# --- Birthday and event flyers for WhatsApp groups (optional) ---
# The "Phone number ID" of the WhatsApp number group admins chat with to make
# flyers. Leave empty to switch the flyer bot off. See docs/FLYERS.md.
FLYER_PHONE_NUMBER_ID=
# Your WhatsApp number(s), comma separated, in international format
# (e.g. 2348012345678,2348098765432). Owners can set up any number of groups
# and get a message whenever someone new signs up. Required when the flyer bot
# is on. ANTHROPIC_API_KEY (above), if set, writes the birthday messages;
# without it, ready-made messages are used.
FLYER_OWNER_WA_IDS=
# "true" lets anyone who messages the flyer number set up one group of their
# own (needed to sell the service). "false" means only owners can.
FLYER_OPEN_SIGNUP=true
# The service's name, used when greeting people who message the number.
FLYER_BRAND_NAME=Yarn Oga Flyers
# Small print at the bottom of flyers on plans that carry it (Free, Standard),
# also added under the birthday message, where the wa.me link can be tapped.
# Leave empty for none. Example:
# FLYER_CREDIT=Made with Yarn Oga · wa.me/2348012345678
FLYER_CREDIT=
# Hour of the day, Lagos time (0-23), from which birthday flyers go to admins.
FLYER_SEND_HOUR=8
# Name of the approved WhatsApp message template used to send a birthday flyer
# to an admin who hasn't messaged the bot in the last day (docs/FLYERS.md has
# its wording). Leave empty and such admins get the flyer when they next message.
FLYER_TEMPLATE_NAME=
# The template's language code in WhatsApp Manager.
FLYER_TEMPLATE_LANGUAGE=en
