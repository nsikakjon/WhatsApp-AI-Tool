# Copy this file to .env and fill in real values. Never commit .env.
# On Railway, add each of these under your service's "Variables" tab instead.

# Port the server listens on. Railway sets this for you automatically.
PORT=3000

# --- WhatsApp Cloud API (from your Meta app: WhatsApp > API Setup) ---
# A password you invent. You type the same value into Meta's webhook settings
# so Meta can prove the webhook URL is yours.
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-string
# App secret (Meta app > App settings > Basic > App secret). Used to check that
# incoming webhooks really came from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Access token used to send messages (temporary token for testing, or a
# permanent System User token for production).
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# The "Phone number ID" shown under WhatsApp > API Setup (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Graph API version used in API calls.
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- Supabase (Project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server-only: never put it in a website or mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
