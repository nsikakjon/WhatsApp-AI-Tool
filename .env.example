# Copy this file to .env and fill in real values. Never commit .env.
# On Railway, add each of these under your service's "Variables" tab instead.

# Port the server listens on. Railway sets this for you automatically.
PORT=3000

# --- WhatsApp Cloud API (from your Meta app: WhatsApp > API Setup) ---
# A password you invent. You type the same value into Meta's webhook settings
# so Meta can prove the webhook URL is yours.
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-string
# App secret (Meta app > App settings > Basic > App secret). Used to check that
# incoming webhooks really came from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Access token used to send messages (temporary token for testing, or a
# permanent System User token for production).
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# The "Phone number ID" shown under WhatsApp > API Setup (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Graph API version used in API calls.
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- Owner replies from the WhatsApp Business app (coexistence) ---
# If the business also uses the WhatsApp Business app on the bot's number, the
# bot goes quiet in a chat for this many minutes after the owner's latest reply
# from the app, then answers again. 0 switches this off. See docs/COEXISTENCE.md.
OWNER_REPLY_PAUSE_MINUTES=60

# --- Supabase (Project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server-only: never put it in a website or mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Staff inbox (optional) ---
# A web page at https://<your-railway-address>/inbox where staff read chats,
# reply, and take a chat over from the bot. This is the password staff type to
# log in (at least 12 characters). Leave empty to switch the inbox off.
# Changing it logs everyone out.
INBOX_PASSWORD=

# --- Voice notes (optional) ---
# Groq API key (console.groq.com > API Keys) used to turn voice notes into text.
# Leave empty to switch voice notes off; customers are then asked to type.
GROQ_API_KEY=
# Groq speech-to-text model.
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Which product answers messages ---
# "echo" repeats messages back (Phase 0 test). "quote" runs the quote and order
# bot for the business on this number. Leave as echo until its price list is
# loaded in Supabase.
ACTIVE_PRODUCT=echo

# --- Quote and order bot (only needed when ACTIVE_PRODUCT=quote) ---
# Anthropic API key (console.anthropic.com > API keys). Used to understand customers.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Claude model used to read messages.
ANTHROPIC_MODEL=claude-haiku-5-5
# Business name the bot uses in replies.
QUOTE_BUSINESS_NAME=KahnPrints
# Optional. What the business does, in a few words, e.g. "a print shop" or
# "a bakery". Helps the AI understand customers.
QUOTE_BUSINESS_DESCRIPTION=
# Order numbers look like KP-1001.
QUOTE_ORDER_PREFIX=KP
# Optional. The business's language, "en" (English, the default) or "fr"
# (French): owner messages and invoices use it, and customers get it when it
# isn't clear which language they write in. Customers who write in French
# always get French replies, and English writers get English.
QUOTE_LANGUAGE=en
# Optional. The currency prices are in: NGN (naira, the default), XOF (West
# African CFA franc) or XAF (Central African CFA franc).
QUOTE_CURRENCY=NGN
# Optional. "true" answers a customer's voice note with a voice note as well as
# text (needs AZURE_SPEECH_KEY or GOOGLE_TTS_API_KEY).
QUOTE_VOICE_REPLIES=false

# --- Voice replies (optional) ---
# Microsoft Azure Speech, free tier (recommended): in the Azure portal create a
# "Speech service" resource on the Free F0 pricing tier, then copy Key 1 and
# the Location/Region from its "Keys and Endpoint" page. When these are set,
# Azure is used and the Google settings below are ignored. See docs/FRENCH.md.
AZURE_SPEECH_KEY=
# e.g. westeurope
AZURE_SPEECH_REGION=
# Optional. Voices instead of the defaults (fr-FR-DeniseNeural for French,
# en-NG-EzinneNeural, a Nigerian English voice, for English).
AZURE_TTS_VOICE_FR=
AZURE_TTS_VOICE_EN=
# Or Google: a Google Cloud API key with the Text-to-Speech API switched on (Google Cloud
# console > APIs & Services > Credentials). Lets businesses with voice replies
# on answer voice notes with a voice note. See docs/FRENCH.md.
GOOGLE_TTS_API_KEY=
# Optional. Voice names to use instead of the defaults (fr-FR-Neural2-A and
# en-GB-Neural2-A), from Google's list of voices.
GOOGLE_TTS_VOICE_FR=
GOOGLE_TTS_VOICE_EN=
# WhatsApp number that gets a message for every confirmed order, in international
# format with no + or spaces (e.g. 2348012345678). Leave empty for no alerts.
QUOTE_OWNER_WA_ID=
# Optional. Printed under the business name on invoices and receipts. Use " | "
# to start a new line, e.g. 12 Example Street, Ikeja | 0800 000 0000
QUOTE_BUSINESS_DETAILS=
# Optional. Bank details printed on invoices so customers know where to pay,
# e.g. Bank name 0000000000 | Account name. Use " | " to start a new line.
QUOTE_PAYMENT_DETAILS=
# Optional. The plan this business is on: free, starter, pro, growth or
# enterprise (plans and prices are in the quote_plans table, migrations 0021
# and 0034; see docs/QUOTE_PLANS.md). "free" allows
# 50 confirmed orders a month and adds "Powered by yarnOga" to quotes. Leave
# empty for no plan limits (how KahnPrints runs). This is for the business on the
# main number; other businesses use plan_code in the quote_businesses table.
QUOTE_PLAN=
# "true" makes each plan's features count (rows in quote_plan_features,
# migrations 0025 and 0026): a monthly number of AI replies (after that the bot
# keeps quoting with a simple numbered menu), and whether voice notes and
# invoice pictures and delivery are included. Only affects businesses on a plan (QUOTE_PLAN
# above, or plan_code for other businesses). Leave false for no change.
QUOTE_PLAN_FEATURES=false
# "true" lets an owner whose plan has a monthly AI reply limit buy a pack of
# extra replies: they send "top up" to the bot, or press the button on the owner
# app's dashboard, and pay by Paystack link. Packs and prices are in the
# quote_ai_packs table (migration 0063). Needs QUOTE_PLAN_FEATURES and
# PAYSTACK_SECRET_KEY. Leave false for no change.
QUOTE_AI_TOPUPS=false
# "true" sends owners their plan limit warnings with one-tap buttons (Upgrade,
# and Top up for AI replies), adds a heads-up at 80% of the month's orders, and
# when the orders run out hands that customer's chat to the owner for 24 hours
# so the bot doesn't keep answering them. No migration needed. Leave false for
# no change.
QUOTE_LIMIT_ALERTS=false
# "true" gives each quote business owner a private orders page: the owner sends
# "orders" to the bot and gets a link to their order board and sales figures
# (Pro and above when QUOTE_PLAN_FEATURES is on). Needs migration 0036 and
# PUBLIC_URL (this server's https address). See docs/ORDER_BOARD.md.
QUOTE_ORDER_BOARD=false
# "true" switches on walk-in orders for restaurants, bars and events (Starter
# and above when QUOTE_PLAN_FEATURES is on): owners send "walk-in on", paid
# orders go to kitchen and bar screens, and receipts carry a QR code staff
# scan at collection. Needs migration 0047 and PUBLIC_URL. See docs/WALK_IN.md.
# yarnOga's fee on pay-link payments needs no switch: it comes from each
# plan's transaction_fee row (migration 0048).
QUOTE_WALK_IN=false
# "true" switches on product photos and stock levels for the quote bot (Pro
# and above when QUOTE_PLAN_FEATURES is on): owners send "stock" and photos
# captioned "photo <product>". Needs migration 0037. See docs/CATALOGUE.md.
QUOTE_CATALOGUE=false
# "true" adds Counter sale to the owner app: staff tap what a walk-in shopper
# bought, the stock goes down and the sale is recorded. Also adds a cost price
# to each price list row, so the dashboard shows profit per sale and per
# product. Needs migration 0060. See docs/COUNTER_SALES.md.
QUOTE_COUNTER_SALES=false
# "true" gives every quote business a public shop page, <PUBLIC_URL>/shop/<name>,
# on every plan: owners send "shop" for the link. Customers pick quantities and
# WhatsApp opens with the order typed. Needs migration 0059 and PUBLIC_URL.
# See docs/SHOP.md.
QUOTE_SHOP=false
# "true" lets a quote business have branches (more WhatsApp numbers on one
# plan), chosen on the setup screen: up to 3 numbers on Growth. Needs
# migration 0038. See docs/QUOTE_BUSINESSES.md.
QUOTE_BRANCHES=false
# "true" gives every quote business (other than the main number) its own
# referral code: owners send "referral" to get it. A business that pays with
# it gets 10% off its first month and the one that shared it gets a free month.
# Needs QUOTE_MULTI_BUSINESS=true, Paystack and migration 0041.
# See docs/PROMO_CODES.md.
QUOTE_REFERRALS=false
# "true" puts a Paystack pay link on quote invoices. The money goes straight to
# the business's own bank account through its Paystack subaccount (set on the
# setup screen; QUOTE_PAYSTACK_SUBACCOUNT for the main number), and the order
# is marked paid with a receipt once Paystack confirms. Businesses without a
# subaccount are unchanged. Needs Paystack and migration 0045. See docs/PAY_LINKS.md.
QUOTE_PAY_LINKS=false
# Optional. The main number's Paystack subaccount code, e.g. ACCT_8f4s1eq7ml6rlzj
# (Paystack > Subaccounts). Not a secret, but only set it once the subaccount exists.
QUOTE_PAYSTACK_SUBACCOUNT=
# Optional. For a main number that sells in CFA francs (QUOTE_CURRENCY=XOF or
# XAF): its Flutterwave subaccount ID, e.g. RS_A1B2C3D4E5F6 (Flutterwave >
# Subaccounts). Pay links then take Mobile Money and cards through Flutterwave.
QUOTE_FLUTTERWAVE_SUBACCOUNT=
# "true" lets each quote business make discount codes for its own customers
# (a Christmas sale, an influencer's code): owners send "new code XMAS 20%",
# customers send XMAS after a quote. Needs migration 0042.
# See docs/DISCOUNT_CODES.md.
QUOTE_DISCOUNT_CODES=false

# --- More businesses on the quote bot (optional) ---
# "true" lets other businesses use the quote bot, each on its own WhatsApp
# number with its own price list, orders and alert number (rows in the
# quote_businesses table; see docs/QUOTE_BUSINESSES.md). Run migration
# 0020_quote_businesses.sql first. Needs ANTHROPIC_API_KEY (above).
# Leave false and the bot works for the one business above only, as before.
QUOTE_MULTI_BUSINESS=false
# A password you invent (at least 12 characters) for the owner setup screen at
# https://<your-railway-url>/quote-setup, where you add businesses and upload
# their price lists. Needs migrations 0020 and 0023. Leave empty to switch the
# screen off.
QUOTE_SETUP_PASSWORD=
# true adds "Let AI draft it" to the setup screen's price list page: the owner
# describes what they sell or adds photos of their price list, and the AI fills
# in draft rows for them to check, correct and save. The AI never saves
# anything itself. Needs ANTHROPIC_API_KEY (above) and QUOTE_SETUP_PASSWORD.
QUOTE_SETUP_AI_DRAFT=false
# Most AI drafts per day across all businesses, to cap the AI bill. Default 30.
QUOTE_SETUP_AI_DRAFTS_PER_DAY=30
# Sign-up by WhatsApp chat: the "Phone number ID" of the yarnOga quotes number
# (the one that runs the demo shop). Anyone who sends "sign up" to it is walked
# through adding their business and price list, on the Free plan. Needs
# QUOTE_MULTI_BUSINESS=true and migration 0039. Leave empty to switch it off.
# See docs/QUOTE_BUSINESSES.md.
QUOTE_SIGNUP_PHONE_NUMBER_ID=
# Optional: a WhatsApp number (e.g. 2348012345678) told about each new sign-up.
QUOTE_SIGNUP_ALERT_WA_ID=
# "true" keeps price lists in step with the owner's Google Sheet: a list saved
# from a sheet link remembers it, the sheet is read once a day, and the owner
# is told on WhatsApp to send "update prices" when it changes ("refresh" checks
# at once). Needs migration 0040. See docs/QUOTE_BUSINESSES.md.
QUOTE_PRICE_SHEETS=false

# --- Quote follow-up reminders (optional) ---
# "true" sends one polite reminder to customers who got a quote but never
# replied YES (see docs/QUOTE_FOLLOW_UPS.md). Run migration
# 0027_quote_follow_ups.sql first. Leave false and no reminders are sent.
QUOTE_FOLLOW_UPS=false
# Hours after the quote before the reminder goes (24 = next day). Other
# businesses can set their own in the quote_businesses table.
QUOTE_FOLLOW_UP_HOURS=24
# Name of the approved WhatsApp template used when the customer last messaged
# more than a day ago. Leave empty and those customers get no reminder.
QUOTE_FOLLOW_UP_TEMPLATE_NAME=
# The template's language code in WhatsApp Manager.
QUOTE_FOLLOW_UP_TEMPLATE_LANGUAGE=en

# --- Quote bot broadcasts (optional, paid add-on) ---
# "true" lets quote bot businesses send offers to customers who opted in
# (they send JOIN; STOP opts out). Run migration 0029_broadcasts.sql first, and
# give each business that bought the add-on a row in broadcast_addons.
# See docs/BROADCASTS.md. Leave false and nothing changes.
BROADCASTS_ENABLED=false
# The approved Marketing template's name in WhatsApp Manager (needed when on).
BROADCAST_TEMPLATE_NAME=
# A second approved template with a picture header, for broadcasts with a photo.
# Leave empty and broadcasts are text only.
BROADCAST_IMAGE_TEMPLATE_NAME=
# The templates' language code in WhatsApp Manager.
BROADCAST_TEMPLATE_LANGUAGE=en
# Messages sent per minute across all broadcasts (keeps within Meta's limits).
BROADCASTS_PER_MINUTE=30
# Optional: Meta's rough charge per marketing message, in KOBO (e.g. 7000 for
# N70), so the preview can estimate the cost. Leave empty to skip the estimate.
BROADCAST_COST_KOBO=

# --- Delivery for the quote bot (optional) ---
# "true" makes the bot ask where to deliver before an order is placed, adds the
# delivery fee from your zones as its own line, and lets the owner send their
# own riders out with tracking links. Run migration 0030_quote_delivery.sql
# first and add your zones (see docs/DELIVERY.md). Leave false to keep
# arranging delivery yourself, as before.
QUOTE_DELIVERY=false
# Tracking links use PUBLIC_URL (set in the Payments section below), so it
# must be filled in even if Paystack isn't.
# Optional. An approved "Utility" template so delivery updates still reach a
# rider or customer who hasn't messaged in the last 24 hours. Its body needs
# three values: order number, business name, update. See docs/DELIVERY.md.
QUOTE_DELIVERY_TEMPLATE_NAME=
QUOTE_DELIVERY_TEMPLATE_LANGUAGE=en

# --- Construction site progress reporter (optional) ---
# The "Phone number ID" of a second WhatsApp number (e.g. Meta's test number).
# Messages to that number go to the site reporter; the number above keeps
# running ACTIVE_PRODUCT. Leave empty to switch the site reporter off.
# Needs ANTHROPIC_API_KEY (above) to write the daily reports.
SITE_PHONE_NUMBER_ID=
# Hour of the day, Lagos time (0-23), when the daily report goes to site managers.
SITE_REPORT_HOUR=18

# --- Real estate lead qualifier (optional) ---
# The "Phone number ID" of the WhatsApp number property enquiries come in on.
# Messages to that number go to the lead qualifier. Leave empty to switch it off.
# Needs ANTHROPIC_API_KEY (above) to read messages.
LEADS_PHONE_NUMBER_ID=
# Agents who get a WhatsApp alert for every hot lead, in international format,
# separated by commas (e.g. 2348012345678,2348098765432). Required when the
# lead qualifier is on. Agents can also text "leads" to that number.
LEADS_AGENT_WA_IDS=
# The business name the bot uses with enquirers, e.g. "Acme Homes".
LEADS_BUSINESS_NAME=

# --- Birthday and event flyers for WhatsApp groups (optional) ---
# The "Phone number ID" of the WhatsApp number group admins chat with to make
# flyers. Leave empty to switch the flyer bot off. See docs/FLYERS.md.
FLYER_PHONE_NUMBER_ID=
# Your WhatsApp number(s), comma separated, in international format
# (e.g. 2348012345678,2348098765432). Owners can set up any number of groups
# and get a message whenever someone new signs up. Required when the flyer bot
# is on. ANTHROPIC_API_KEY (above), if set, writes the birthday messages;
# without it, ready-made messages are used.
FLYER_OWNER_WA_IDS=
# "true" lets anyone who messages the flyer number set up one group of their
# own (needed to sell the service). "false" means only owners can.
FLYER_OPEN_SIGNUP=true
# The service's name, used when greeting people who message the number.
FLYER_BRAND_NAME=yarnOga Flyers
# Small print at the bottom of flyers on plans that carry it (Free, Standard),
# also added under the birthday message, where the wa.me link can be tapped.
# Leave empty for none. Example:
# FLYER_CREDIT=Made with yarnOga · wa.me/2348012345678
FLYER_CREDIT=
# Hour of the day, Lagos time (0-23), from which birthday flyers go to admins.
FLYER_SEND_HOUR=8
# Name of the approved WhatsApp message template used to send a birthday flyer
# to an admin who hasn't messaged the bot in the last day (docs/FLYERS.md has
# its wording). Leave empty and such admins get the flyer when they next message.
FLYER_TEMPLATE_NAME=
# The template's language code in WhatsApp Manager.
FLYER_TEMPLATE_LANGUAGE=en

# --- Owner dashboard (optional) ---
# A password you invent for the analytics page at https://<your-railway-url>/dashboard
# (chats, sign-ups, plans, orders, leads and site updates across all products).
# The browser asks for it; the username can be anything. Leave empty to switch the page off.
DASHBOARD_PASSWORD=

# --- Sign-up page for connecting WhatsApp numbers (optional) ---
# The public page https://<your-railway-url>/signup, where a business connects
# its number through Meta's pop-up (kept in the WhatsApp Business app, or a new
# number). It switches on once META_SIGNUP_CONFIG_ID is set. See docs/COEXISTENCE.md.
# The configuration ID from Facebook Login for Business > Configurations, for
# the configuration made with "WhatsApp Embedded Signup".
META_SIGNUP_CONFIG_ID=
# The Meta app's App ID (Meta app > App settings > Basic). Same app as above.
META_APP_ID=

# --- Social media numbers on the dashboard (optional) ---
# Each one is optional; an account without its values shows "Not connected".
# Steps for getting each value are in docs/DASHBOARD.md.
# Instagram and Facebook: a Meta system user token that can read the yarnOga
# Facebook Page (with the Instagram account linked to that Page), and the Page's id.
META_SOCIAL_TOKEN=
FACEBOOK_PAGE_ID=
# YouTube: an API key from Google Cloud with "YouTube Data API v3" turned on.
YOUTUBE_API_KEY=
# The channel's handle, without the @.
YOUTUBE_HANDLE=yarnoga
# TikTok: the Client key and Client secret of your app on developers.tiktok.com.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Filled in after you click "connect" at /dashboard/tiktok/connect (the page
# shows you the value). Lasts about a year.
TIKTOK_REFRESH_TOKEN=

# --- Owner test screen (optional) ---
# A password (at least 12 characters) switches on the bot test screen at
# https://<your-railway-url>/bot-test, where you try the sales assistant or the
# lead qualifier on common customer questions and mark each answer good or
# poor. It never sends WhatsApp messages. Leave empty to switch it off.
BOT_TEST_PASSWORD=
# Most test answers per day (each one is a small AI cost).
BOT_TEST_DAILY_LIMIT=300

# --- Free reply generator on the website (optional) ---
# "true" switches on the free "WhatsApp reply generator" on yarnoga.com
# (https://<your-railway-url>/tools/reply-generator). Visitors describe their
# business and get ready-to-paste WhatsApp messages. Uses ANTHROPIC_API_KEY
# (above), so each answer costs a little. Leave false to switch it off.
REPLY_GENERATOR_ENABLED=false
# Website addresses allowed to use it, separated by commas.
REPLY_GENERATOR_ORIGINS=https://yarnoga.com,https://www.yarnoga.com
# Answers each visitor gets per day.
REPLY_GENERATOR_VISITOR_LIMIT=5
# Answers for all visitors together per day (keeps the AI bill capped).
REPLY_GENERATOR_DAILY_LIMIT=200

# --- Payments through Paystack (optional) ---
# Secret key from Paystack > Settings > API Keys & Webhooks. Start with the
# test key (sk_test_...); switch to the live key (sk_live_...) when ready.
# Leave empty and nothing is charged: owners take payment by hand.
# Steps, including the webhook URL to set in Paystack, are in docs/PAYMENTS.md.
PAYSTACK_SECRET_KEY=
# This server's public https address: https://app.yarnoga.com (or the Railway
# address before that domain works). See docs/CUSTOM_DOMAIN.md.
# Payers return to <PUBLIC_URL>/payments/done after paying.
PUBLIC_URL=
# Paystack needs an email on every payment. Used when we don't have the payer's
# own email for receipts (see docs/PAYMENTS.md); those receipts come here.
PAYSTACK_CUSTOMER_EMAIL=

# Optional. "true" reminds customers who confirmed an order but haven't paid:
# at most two reminders (about 3 and 20 hours later), inside WhatsApp's free
# 24-hour window, daytime only. Each business can switch them off in the app.
# Needs migration 0054. See docs/CUSTOMER_CARE.md.
QUOTE_PAY_REMINDERS=false
# Optional. "true" asks customers how their order went, once per paid order,
# with Great / OK / Not good buttons, inside WhatsApp's free 24-hour window.
# "Not good" alerts the owner. Ratings show on the app's dashboard. Each
# business can switch it off. Needs migration 0054.
QUOTE_RATINGS=false

# --- Couriers through Shipbubble (optional) ---
# For addresses outside a business's own delivery zones, the bot offers the
# cheapest courier (Kwik, Gokada, GIG and others) at Shipbubble's price.
# yarnOga's Shipbubble wallet pays the courier, only after the fee has been
# collected by pay link. API key from Shipbubble > Settings > API keys:
# sb_sandbox_... for testing, sb_prod_... when live. Needs Paystack (above),
# QUOTE_DELIVERY and migration 0053. Set the webhook URL in Shipbubble to
# <PUBLIC_URL>/webhooks/shipbubble. See docs/COURIERS.md.
SHIPBUBBLE_API_KEY=
# Optional. Shipbubble needs an email for every sender and receiver; this one is
# used. PAYSTACK_CUSTOMER_EMAIL is used when empty.
SHIPBUBBLE_CONTACT_EMAIL=
# Optional. Package category from Shipbubble's list; its first category when empty.
SHIPBUBBLE_CATEGORY_ID=
# Optional. Weight of one item in kg, for the courier's price (default 0.5).
SHIPBUBBLE_ITEM_KG=
# Optional. "true" offers Shipbubble couriers on the main number. Other
# businesses switch it on in the app under Riders & delivery.
QUOTE_COURIER_DELIVERY=false

# --- CFA franc payments through Flutterwave (optional) ---
# Mobile Money (MTN MoMo, Orange Money, Moov, Wave) and cards for businesses
# in French-speaking Africa. Secret key from Flutterwave > Settings > API Keys:
# FLWSECK_TEST-... for testing, FLWSECK-... when live. Never put it anywhere but
# here and Railway. Needs PUBLIC_URL above and migration 0052. See docs/FRENCH.md.
FLUTTERWAVE_SECRET_KEY=
# A long random phrase you make up (at least 16 characters). Type the same one
# in Flutterwave > Settings > Webhooks > Secret hash, with the webhook URL
# <PUBLIC_URL>/webhooks/flutterwave. It proves webhooks really come from Flutterwave.
FLUTTERWAVE_SECRET_HASH=
# Optional. The email put on Flutterwave payments; PAYSTACK_CUSTOMER_EMAIL is used if empty.
FLUTTERWAVE_CUSTOMER_EMAIL=

# --- yarnOga plans paid in other currencies (optional) ---
# Which currencies besides naira people can pay for a quote bot or flyer plan
# in, at the fixed prices in the plan_prices table (migration 0062). The bot
# picks the currency from the payer's WhatsApp number: Ghana pays in cedis,
# Kenya in shillings, CFA franc countries in CFA francs, anyone else outside
# Nigeria in US dollars. Leave empty to charge everyone in naira.
# USD goes through Paystack (switch on international payments there first);
# XOF, XAF, GHS and KES go through Flutterwave (needs FLUTTERWAVE_SECRET_KEY,
# and Flutterwave must have cedis and shillings switched on for the account).
# See docs/PAYMENTS.md. Example: PLAN_CURRENCIES=XOF,XAF,USD
PLAN_CURRENCIES=

# --- Alerts to Jay when something breaks (optional, recommended) ---
# Jay's WhatsApp number, digits with the country code. Gets a message when an
# error happens (at most every 30 minutes) and when a health check fails or
# recovers. See docs/MONITORING.md.
ALERT_WA_ID=
# An approved WhatsApp Utility template with one value ({{1}} = the alert),
# used when Jay hasn't messaged the bot in the last day. Without it, WhatsApp
# alerts only arrive within a day of Jay's last message to the bot.
ALERT_TEMPLATE_NAME=
ALERT_TEMPLATE_LANGUAGE=en
# Email alerts through resend.com (free: 100 emails a day). The API key is
# from resend.com > API Keys. ALERT_EMAIL_FROM must be on a domain verified in
# Resend (e.g. alerts@yarnoga.com).
ALERT_EMAIL=
RESEND_API_KEY=
ALERT_EMAIL_FROM=yarnOga alerts <alerts@yarnoga.com>
# Error tracking at sentry.io (free tier). The DSN is in Sentry > Project
# settings > Client Keys (DSN). Leave empty to switch it off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Owners' and staff app (optional) ---
# "true" switches on the web app at <PUBLIC_URL>/app (and app.yarnoga.com once
# that domain points here): dashboard, inbox, orders, price list, riders and
# delivery zones, bot test, QR posters, exports, bank accounts, alert numbers
# and team. Needs migration 0049. Steps in docs/OWNER_APP.md.
OWNER_APP=false
# The address people open the app at, used in the WhatsApp login links.
# Leave empty to use PUBLIC_URL (normally https://app.yarnoga.com).
OWNER_APP_URL=
# Where the app's Help page sends people.
SUPPORT_EMAIL=support@yarnoga.com
# yarnOga's support WhatsApp number (digits with country code). Optional.
SUPPORT_WA_ID=

# --- Welcome and setup-tip emails (optional) ---
# "true" switches on yarnOga's own emails to our customers (business owners,
# group admins): the bot asks for an email after their first success, and a
# timer sends the welcome and tip emails one at a time. Every email has an
# unsubscribe link, and "stop emails" on WhatsApp unsubscribes too. Needs
# migration 0057, RESEND_API_KEY (above) and PUBLIC_URL. Steps, including the
# Hostinger DNS records, in docs/EMAILS.md.
EMAILS_ENABLED=false
# Who the emails come from. The part in <> must be on a domain verified in
# Resend (updates.yarnoga.com), never a personal Gmail.
EMAIL_FROM=Nsikak John at yarnOga <hello@updates.yarnoga.com>
# Where replies go (a mailbox a person reads). Leave empty to use SUPPORT_EMAIL.
EMAIL_REPLY_TO=support@yarnoga.com
# Most emails a day in total. Resend's free plan allows 100.
EMAILS_PER_DAY=90

# --- Business verification / compliance page (optional) ---
# A password (at least 12 characters) switches on the compliance page at
# <PUBLIC_URL>/compliance, where Jay reviews the details and documents each
# business sends from the app (Verify business). Needs migration 0050.
# Steps in docs/COMPLIANCE.md.
COMPLIANCE_PASSWORD=
# Optional automatic CAC (company register) checks through Dojah (dojah.io).
# Each live check costs a little from the Dojah wallet; DOJAH_SANDBOX=true
# uses Dojah's free test data. Leave empty to check by hand at search.cac.gov.ng.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_SANDBOX=false
