# Copy this file to .env and fill in real values. Never commit .env.
# On Railway, add each of these under your service's "Variables" tab instead.

# Port the server listens on. Railway sets this for you automatically.
PORT=3000

# --- WhatsApp Cloud API (from your Meta app: WhatsApp > API Setup) ---
# A password you invent. You type the same value into Meta's webhook settings
# so Meta can prove the webhook URL is yours.
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-string
# App secret (Meta app > App settings > Basic > App secret). Used to check that
# incoming webhooks really came from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Access token used to send messages (temporary token for testing, or a
# permanent System User token for production).
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# The "Phone number ID" shown under WhatsApp > API Setup (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Graph API version used in API calls.
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- Owner replies from the WhatsApp Business app (coexistence) ---
# If the business also uses the WhatsApp Business app on the bot's number, the
# bot goes quiet in a chat for this many minutes after the owner's latest reply
# from the app, then answers again. 0 switches this off. See docs/COEXISTENCE.md.
OWNER_REPLY_PAUSE_MINUTES=60

# --- Supabase (Project settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server-only: never put it in a website or mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Staff inbox (optional) ---
# A web page at https://<your-railway-address>/inbox where staff read chats,
# reply, and take a chat over from the bot. This is the password staff type to
# log in (at least 12 characters). Leave empty to switch the inbox off.
# Changing it logs everyone out.
INBOX_PASSWORD=

# --- Voice notes (optional) ---
# Groq API key (console.groq.com > API Keys) used to turn voice notes into text.
# Leave empty to switch voice notes off; customers are then asked to type.
GROQ_API_KEY=
# Groq speech-to-text model.
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Which product answers messages ---
# "echo" repeats messages back (Phase 0 test). "quote" runs the quote and order
# bot for the business on this number. Leave as echo until its price list is
# loaded in Supabase.
ACTIVE_PRODUCT=echo

# --- Quote and order bot (only needed when ACTIVE_PRODUCT=quote) ---
# Anthropic API key (console.anthropic.com > API keys). Used to understand customers.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Claude model used to read messages.
ANTHROPIC_MODEL=claude-haiku-5-5
# Business name the bot uses in replies.
QUOTE_BUSINESS_NAME=KahnPrints
# Optional. What the business does, in a few words, e.g. "a print shop" or
# "a bakery". Helps the AI understand customers.
QUOTE_BUSINESS_DESCRIPTION=
# Order numbers look like KP-1001.
QUOTE_ORDER_PREFIX=KP
# WhatsApp number that gets a message for every confirmed order, in international
# format with no + or spaces (e.g. 2348012345678). Leave empty for no alerts.
QUOTE_OWNER_WA_ID=
# Optional. Printed under the business name on invoices and receipts. Use " | "
# to start a new line, e.g. 12 Example Street, Ikeja | 0800 000 0000
QUOTE_BUSINESS_DETAILS=
# Optional. Bank details printed on invoices so customers know where to pay,
# e.g. Bank name 0000000000 | Account name. Use " | " to start a new line.
QUOTE_PAYMENT_DETAILS=
# Optional. The plan this business is on: free, starter or standard
# (plans and prices are in the quote_plans table, migration 0021). "free" allows
# 50 confirmed orders a month and adds "Powered by yarnOga" to quotes. Leave
# empty for no plan limits (how KahnPrints runs). This is for the business on the
# main number; other businesses use plan_code in the quote_businesses table.
QUOTE_PLAN=
# "true" makes each plan's features count (rows in quote_plan_features,
# migrations 0025 and 0026): a monthly number of AI replies (after that the bot
# keeps quoting with a simple numbered menu), and whether voice notes and
# invoice pictures are included. Only affects businesses on a plan (QUOTE_PLAN
# above, or plan_code for other businesses). Leave false for no change.
QUOTE_PLAN_FEATURES=false

# --- More businesses on the quote bot (optional) ---
# "true" lets other businesses use the quote bot, each on its own WhatsApp
# number with its own price list, orders and alert number (rows in the
# quote_businesses table; see docs/QUOTE_BUSINESSES.md). Run migration
# 0020_quote_businesses.sql first. Needs ANTHROPIC_API_KEY (above).
# Leave false and the bot works for the one business above only, as before.
QUOTE_MULTI_BUSINESS=false
# A password you invent (at least 12 characters) for the owner setup screen at
# https://<your-railway-url>/quote-setup, where you add businesses and upload
# their price lists. Needs migrations 0020 and 0023. Leave empty to switch the
# screen off.
QUOTE_SETUP_PASSWORD=
# true adds "Let AI draft it" to the setup screen's price list page: the owner
# describes what they sell or adds photos of their price list, and the AI fills
# in draft rows for them to check, correct and save. The AI never saves
# anything itself. Needs ANTHROPIC_API_KEY (above) and QUOTE_SETUP_PASSWORD.
QUOTE_SETUP_AI_DRAFT=false
# Most AI drafts per day across all businesses, to cap the AI bill. Default 30.
QUOTE_SETUP_AI_DRAFTS_PER_DAY=30

# --- Construction site progress reporter (optional) ---
# The "Phone number ID" of a second WhatsApp number (e.g. Meta's test number).
# Messages to that number go to the site reporter; the number above keeps
# running ACTIVE_PRODUCT. Leave empty to switch the site reporter off.
# Needs ANTHROPIC_API_KEY (above) to write the daily reports.
SITE_PHONE_NUMBER_ID=
# Hour of the day, Lagos time (0-23), when the daily report goes to site managers.
SITE_REPORT_HOUR=18

# --- Real estate lead qualifier (optional) ---
# The "Phone number ID" of the WhatsApp number property enquiries come in on.
# Messages to that number go to the lead qualifier. Leave empty to switch it off.
# Needs ANTHROPIC_API_KEY (above) to read messages.
LEADS_PHONE_NUMBER_ID=
# Agents who get a WhatsApp alert for every hot lead, in international format,
# separated by commas (e.g. 2348012345678,2348098765432). Required when the
# lead qualifier is on. Agents can also text "leads" to that number.
LEADS_AGENT_WA_IDS=
# The business name the bot uses with enquirers, e.g. "Acme Homes".
LEADS_BUSINESS_NAME=

# --- Birthday and event flyers for WhatsApp groups (optional) ---
# The "Phone number ID" of the WhatsApp number group admins chat with to make
# flyers. Leave empty to switch the flyer bot off. See docs/FLYERS.md.
FLYER_PHONE_NUMBER_ID=
# Your WhatsApp number(s), comma separated, in international format
# (e.g. 2348012345678,2348098765432). Owners can set up any number of groups
# and get a message whenever someone new signs up. Required when the flyer bot
# is on. ANTHROPIC_API_KEY (above), if set, writes the birthday messages;
# without it, ready-made messages are used.
FLYER_OWNER_WA_IDS=
# "true" lets anyone who messages the flyer number set up one group of their
# own (needed to sell the service). "false" means only owners can.
FLYER_OPEN_SIGNUP=true
# The service's name, used when greeting people who message the number.
FLYER_BRAND_NAME=yarnOga Flyers
# Small print at the bottom of flyers on plans that carry it (Free, Standard),
# also added under the birthday message, where the wa.me link can be tapped.
# Leave empty for none. Example:
# FLYER_CREDIT=Made with yarnOga · wa.me/2348012345678
FLYER_CREDIT=
# Hour of the day, Lagos time (0-23), from which birthday flyers go to admins.
FLYER_SEND_HOUR=8
# Name of the approved WhatsApp message template used to send a birthday flyer
# to an admin who hasn't messaged the bot in the last day (docs/FLYERS.md has
# its wording). Leave empty and such admins get the flyer when they next message.
FLYER_TEMPLATE_NAME=
# The template's language code in WhatsApp Manager.
FLYER_TEMPLATE_LANGUAGE=en

# --- Owner dashboard (optional) ---
# A password you invent for the analytics page at https://<your-railway-url>/dashboard
# (chats, sign-ups, plans, orders, leads and site updates across all products).
# The browser asks for it; the username can be anything. Leave empty to switch the page off.
DASHBOARD_PASSWORD=

# --- Sign-up page for connecting WhatsApp numbers (optional) ---
# A password you invent for https://<your-railway-url>/signup, where a business
# connects its number through Meta's pop-up, keeping the WhatsApp Business app
# on it (coexistence). Leave empty to switch the page off. See docs/COEXISTENCE.md.
SIGNUP_PASSWORD=
# The Meta app's App ID (Meta app > App settings > Basic). Same app as above.
META_APP_ID=
# The configuration ID from Facebook Login for Business > Configurations, for
# the configuration made with "WhatsApp Embedded Signup".
META_SIGNUP_CONFIG_ID=

# --- Social media numbers on the dashboard (optional) ---
# Each one is optional; an account without its values shows "Not connected".
# Steps for getting each value are in docs/DASHBOARD.md.
# Instagram and Facebook: a Meta system user token that can read the yarnOga
# Facebook Page (with the Instagram account linked to that Page), and the Page's id.
META_SOCIAL_TOKEN=
FACEBOOK_PAGE_ID=
# YouTube: an API key from Google Cloud with "YouTube Data API v3" turned on.
YOUTUBE_API_KEY=
# The channel's handle, without the @.
YOUTUBE_HANDLE=yarnoga
# TikTok: the Client key and Client secret of your app on developers.tiktok.com.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Filled in after you click "connect" at /dashboard/tiktok/connect (the page
# shows you the value). Lasts about a year.
TIKTOK_REFRESH_TOKEN=

# --- Owner test screen (optional) ---
# A password (at least 12 characters) switches on the bot test screen at
# https://<your-railway-url>/bot-test, where you try the sales assistant or the
# lead qualifier on common customer questions and mark each answer good or
# poor. It never sends WhatsApp messages. Leave empty to switch it off.
BOT_TEST_PASSWORD=
# Most test answers per day (each one is a small AI cost).
BOT_TEST_DAILY_LIMIT=300

# --- Free reply generator on the website (optional) ---
# "true" switches on the free "WhatsApp reply generator" on yarnoga.com
# (https://<your-railway-url>/tools/reply-generator). Visitors describe their
# business and get ready-to-paste WhatsApp messages. Uses ANTHROPIC_API_KEY
# (above), so each answer costs a little. Leave false to switch it off.
REPLY_GENERATOR_ENABLED=false
# Website addresses allowed to use it, separated by commas.
REPLY_GENERATOR_ORIGINS=https://yarnoga.com,https://www.yarnoga.com
# Answers each visitor gets per day.
REPLY_GENERATOR_VISITOR_LIMIT=5
# Answers for all visitors together per day (keeps the AI bill capped).
REPLY_GENERATOR_DAILY_LIMIT=200

# --- Payments through Paystack (optional) ---
# Secret key from Paystack > Settings > API Keys & Webhooks. Start with the
# test key (sk_test_...); switch to the live key (sk_live_...) when ready.
# Leave empty and nothing is charged: owners take payment by hand.
# Steps, including the webhook URL to set in Paystack, are in docs/PAYMENTS.md.
PAYSTACK_SECRET_KEY=
# This server's public https address, e.g. https://your-app.up.railway.app.
# Payers return to <PUBLIC_URL>/payments/done after paying.
PUBLIC_URL=
# Paystack needs an email on every payment and WhatsApp doesn't give us the
# customer's, so this one is used. Receipts go here.
PAYSTACK_CUSTOMER_EMAIL=
